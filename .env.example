# Required
DISTORTIONER_BOT_TOKEN=123456:replace-me
# Comma-separated Telegram user ids allowed to open /admin
DISTORTIONER_ADMIN_IDS=

# Updates: polling (default) or webhook
#DISTORTIONER_MODE=polling
#DISTORTIONER_WEBHOOK_URL=https://example.com/webhook
#DISTORTIONER_WEBHOOK_SECRET=
#DISTORTIONER_LISTEN_ADDR=:8080

# Self-hosted Bot API server (lifts the 20 MB limit to 2000 MB), see README.
# Keys from https://my.telegram.org → API development tools.
#TELEGRAM_API_ID=
#TELEGRAM_API_HASH=
#DISTORTIONER_API_URL=http://telegram-bot-api:8081
# The server never deletes downloaded files; the bot does (compose sets the dir)
#DISTORTIONER_BOT_API_DIR=/var/lib/telegram-bot-api
#DISTORTIONER_BOT_API_FILES_TTL=3h
#DISTORTIONER_MAX_FILE_MB=20   # initial value; admins can change it in /admin up to the server limit

# Performance
#DISTORTIONER_VIDEO_WORKERS=2
#DISTORTIONER_IMAGE_WORKERS=   # defaults to the number of CPUs
#DISTORTIONER_CPU_LIMIT=       # concurrent ImageMagick processes, defaults to the number of CPUs
#DISTORTIONER_CODEC=libx264    # e.g. h264_nvenc with an NVIDIA GPU
#DISTORTIONER_JOB_TIMEOUT=5m
#DISTORTIONER_SHUTDOWN_GRACE=30s

# Storage
#DISTORTIONER_DATA_DIR=data
#DISTORTIONER_TEMP_DIR=/tmp
#DISTORTIONER_STATS_RETENTION_DAYS=365
#DISTORTIONER_KEEP_FAILED_INPUTS=false
#DISTORTIONER_FAILED_TTL=72h
#DISTORTIONER_FAILED_MAX_MB=500

# Chats that skip queue limits (also editable in /admin)
#DISTORTIONER_PRIORITY_CHATS=

#DISTORTIONER_LOG_LEVEL=info
#DISTORTIONER_LOG_FORMAT=json

# Monitoring profile (docker compose --profile monitoring up -d)
#GRAFANA_ADMIN_PASSWORD=
#GRAFANA_PORT=3000
#PROMETHEUS_PORT=9090
